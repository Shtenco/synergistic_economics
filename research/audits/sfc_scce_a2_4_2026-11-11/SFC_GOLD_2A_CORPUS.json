  "acceptance_controls": [
    "Every event balances in LCU and preserves full holder/issuer/instrument identity.",
    "Impairment allowance changes valuation only; it does not reduce gross principal or borrower legal liability.",
    "Creditor write-off reduces recognized gross loan asset and consumes allowance but does not extinguish the legal debt unless an explicit legal release event exists.",
    "Legal forgiveness reduces both contractual principal and recognized gross claim by the legally forgiven amount; it is not inferred from write-off.",
    "At every checkpoint: contractual principal = recognized gross loan asset + enforceable written-off memorandum claim.",
    "At every checkpoint: net loan carrying = recognized gross loan asset - impairment allowance.",
    "Interest receivable equals interest payable; deposit asset equals deposit liability.",
    "For each account and period, opening + T + V + O = closing; impairment recognition is V, write-off is O, principal repayment/interest accrual/payment/forgiveness are T."
  ],
  "explicit_nonclaims": [
    "This corpus is synthetic, not empirical.",
    "This does not certify IFRS, GAAP, SNA or jurisdiction-specific legal treatment.",
    "The impairment allowance is not central-bank reserve money or collateral.",
    "Legal enforceability of the written-off claim is a frozen synthetic fact, not inferred from an accounting entry."
  ]
}
